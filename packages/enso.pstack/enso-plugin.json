        "mcpServers": [],
        "agentTypes": [
          "pstack:poteto-agent",
          "pstack:comment-sicko"
        ],
        "systemPromptTail": "prompts/poteto.md"
      }
    ],
    "agentTypes": [
      {
        "name": "pstack:poteto-agent",
        "description": "Delegate subagent for code-writing and helper tasks spawned during a poteto-mode run, not the runner itself. Pass the role's model when the subagent tool lists models. Always put the absolute path of pstack's skills/poteto-mode/SKILL.md in the brief.",
        "systemPrompt": "agents/poteto-agent.md",
        "tools": "all",
        "modelMode": "agent_pick"
      },
      {
        "name": "pstack:comment-sicko",
        "description": "A deranged comment-hater that savors deletion and condemns workaround code. Deletes comments in the scoped files or diff and flags workaround code with MUST KILL; never writes application code.",
        "systemPrompt": "agents/comment-sicko.md",
        "tools": "all",
        "modelMode": "agent_pick"
      }
    ],
    "methods": [
      {
        "name": "session",
        "timeoutMs": 2000
      },
      {
        "name": "toggle",
        "timeoutMs": 2000
      }
    ],
    "events": [
      {
        "event": "input",
        "mode": "intercept"
      }
    ]
